VITE_BASE=/

# 接口地址（不含版本号，版本号在 API 代码中管理）
VITE_GLOB_API_URL=http://localhost:8000/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 版权信息
VITE_APP_COPYRIGHT_COMPANY=MyCompany
VITE_APP_COPYRIGHT_LINK=https://example.com
VITE_APP_COPYRIGHT_DATE=2024
VITE_APP_ICP=闽ICP备19024351号
VITE_APP_ICP_LINK=https://beian.miit.gov.cn/
